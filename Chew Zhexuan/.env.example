APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_BASE_URL=http://127.0.0.1:8083

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=election_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Use the same directory and name as the Election service so a login works on both local ports.
SESSION_STORAGE=../LowWenKai/storage/sessions
SESSION_NAME=VOTETRUST_ELECTION

# Security strategies. Disable an active account after this many consecutive failed sign-ins.
AUTH_PROTECTION_STRATEGY=disable_after_failures
AUTH_MAX_FAILED_ATTEMPTS=5
LOGOUT_STRATEGY=full_session_termination

# Shared secret for server-to-server eligibility requests from the Voting module.
USER_API_KEY=replace-with-a-long-local-secret
API_REQUEST_MAX_AGE_SECONDS=300
