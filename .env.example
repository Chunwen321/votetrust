APP_NAME=VoteTrust
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://votetrust.test
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Create this empty database in MySQL before the first migration.
DB_DATABASE=votetrust
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PIC: Chew Zhexuan — User, Voter, and Admin module
AUTH_MAX_FAILED_ATTEMPTS=5
# Local self-service examples only. Replace every matching provider/consumer pair outside local development.
USER_API_KEY=votetrust-user-local-2026
API_REQUEST_MAX_AGE_SECONDS=300
API_RESPONSE_MAX_AGE_SECONDS=300
EKYC_DRIVER=local
EKYC_PROVIDER_URL=
EKYC_PROVIDER_API_KEY=
EKYC_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
EKYC_PROVIDER_TIMEOUT_SECONDS=10
EKYC_PROVIDER_RESPONSE_MAX_AGE_SECONDS=300
# Set EKYC_DRIVER=didit after creating a KYC workflow in Didit's Business Console.
# The Didit API key and webhook secret must remain server-side; never expose them in Vite/JavaScript variables.
DIDIT_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_TOLERANCE_SECONDS=300
# Election Module calls this User/Voter API to match private-election CSV rows.
USER_SERVICE_BASE_URL=http://votetrust.test
USER_SERVICE_API_KEY=votetrust-user-local-2026
VOTING_SERVICE_BASE_URL=http://votetrust.test
VOTING_SERVICE_API_KEY=votetrust-voting-local-2026
VOTING_SERVICE_CONNECT_TIMEOUT_SECONDS=2
VOTING_SERVICE_TIMEOUT_SECONDS=5
ELECTION_SERVICE_BASE_URL=http://votetrust.test
ELECTION_SERVICE_API_KEY=votetrust-election-local-2026
ELECTION_SERVICE_CONNECT_TIMEOUT_SECONDS=2
ELECTION_SERVICE_TIMEOUT_SECONDS=5
CANDIDATE_SERVICE_BASE_URL=http://votetrust.test
CANDIDATE_SERVICE_API_KEY=votetrust-candidate-local-2026
CANDIDATE_SERVICE_CONNECT_TIMEOUT_SECONDS=2
CANDIDATE_SERVICE_TIMEOUT_SECONDS=5

# PIC: Low Wen Kai — Election Management Module
# Payment remains an external teammate service. Supply these credentials only when that service is running.
PAYMENT_API_URL=http://127.0.0.1:8081/api/v1/payments/verify
PAYMENT_API_KEY=
PAYMENT_API_TIMEOUT=4
PAYMENT_API_RESPONSE_CLOCK_SKEW_SECONDS=300
ADMIN_API_KEY=
ELECTION_SECURITY_LOG_CHANNEL=stack
ELECTION_API_CLOCK_SKEW_SECONDS=300
ELECTION_API_KEY=votetrust-election-local-2026

# PIC: Wong Shun Bin — Candidate Registration module
CANDIDATE_STORAGE_DISK=local
CANDIDATE_PHOTOS_DIRECTORY=candidate/photos
CANDIDATE_DOCUMENTS_DIRECTORY=candidate/documents
CANDIDATE_DEPOSIT_AMOUNT=10.00
CANDIDATE_MAX_DOCUMENTS=5
CANDIDATE_MAX_PHOTO_KILOBYTES=2048
CANDIDATE_MAX_DOCUMENT_KILOBYTES=5120
CANDIDATE_API_KEY=votetrust-candidate-local-2026
CANDIDATE_API_CLOCK_SKEW_SECONDS=300
CANDIDATE_PAYMENT_API_BASE_URL=http://127.0.0.1:8081
# External Payment service credential; intentionally blank in this repository.
CANDIDATE_PAYMENT_API_KEY=
CANDIDATE_PAYMENT_CONNECT_TIMEOUT_SECONDS=2
CANDIDATE_PAYMENT_TIMEOUT_SECONDS=5
CANDIDATE_PAYMENT_RESPONSE_MAX_AGE_SECONDS=300

# PIC: Payment Module
PAYMENT_GATEWAY=mock
PAYMENT_CANDIDATE_API_BASE_URL=
PAYMENT_CANDIDATE_CONNECT_TIMEOUT_SECONDS=2
PAYMENT_CANDIDATE_TIMEOUT_SECONDS=5
PAYMENT_CANDIDATE_RESPONSE_MAX_AGE_SECONDS=300
PAYMENT_ELECTION_API_BASE_URL=
PAYMENT_ELECTION_CONNECT_TIMEOUT_SECONDS=2
PAYMENT_ELECTION_TIMEOUT_SECONDS=5
PAYMENT_ELECTION_RESPONSE_MAX_AGE_SECONDS=300

# PIC: Goh Chun Wen — Voting Process module
VOTING_API_KEY=votetrust-voting-local-2026
VOTING_LOCK_SECONDS=10
VOTING_LOCK_WAIT_SECONDS=3
VOTING_CAST_RATE_LIMIT_PER_MINUTE=10
ELECTION_SERVICE_BASE_URL=http://votetrust.test
ELECTION_SERVICE_API_KEY=votetrust-election-local-2026
ELECTION_SERVICE_CONNECT_TIMEOUT_SECONDS=2
ELECTION_SERVICE_TIMEOUT_SECONDS=5
USER_SERVICE_BASE_URL=http://votetrust.test
USER_SERVICE_API_KEY=votetrust-user-local-2026
USER_SERVICE_CONNECT_TIMEOUT_SECONDS=2
USER_SERVICE_TIMEOUT_SECONDS=5
